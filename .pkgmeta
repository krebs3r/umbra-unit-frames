package-as: UmbraUnitFrames

externals:
  Libs/oUF:
    url: https://github.com/oUF-wow/oUF
    tag: latest

ignore:
  - .github
  - docs
  - assets
  - tools
  - RELEASE_NOTES.md

# Written by the release workflow from the newest section of CHANGELOG.md, so
# a release carries its own notes and not every one before it.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
