package-as: UmbraUnitFrames

externals:
  Libs/oUF:
    url: https://github.com/oUF-wow/oUF
    # Pinned to the version this was tested against. `latest` would hand a
    # release whatever oUF tagged last, tested here or not.
    tag: 14.1.1

ignore:
  - .github
  - docs
  - assets
  - tools
  - RELEASE_NOTES.md

# Written by the release workflow from the newest section of CHANGELOG.md, so
# a release carries its own notes and not every one before it.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
